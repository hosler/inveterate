# Django Configuration
DEBUG=on
SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DB_NAME=inveterate
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost          # Use 'db' for Docker Compose
DB_PORT=5432

# Redis Configuration (for Celery)
REDIS_HOST=localhost       # Use 'redis' for Docker Compose
REDIS_URL=redis://localhost:6379/0

# Proxmox Cluster (optional, for `manage.py init_cluster`)
# PROXMOX_CLUSTER_NAME=default
# PROXMOX_HOST=taban.hosnet.internal
# PROXMOX_USER=root@pam
# PROXMOX_KEY=your-api-token-value

# CORS Settings
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ALLOW_CREDENTIALS=off

# Security Settings (Production)
SECURE_SSL_REDIRECT=off
SECURE_HSTS_SECONDS=0
